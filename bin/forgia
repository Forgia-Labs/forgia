#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VAULT_DIR=".forgia"

usage() {
  cat <<USAGE
Usage: forgia <command> [arguments]

Incantesimi (comandi):
  init                          Forgia il vault .forgia/ nel progetto
  status                        Mostra la dashboard FD + SDD
  doctor                        Verifica salute (docker, openhands, vault)
  validate <sdd-file|FD-NNN>    Valida un SDD o tutti gli SDD di un FD
  exec <sdd-file> [--runner=X]  Esegui un SDD (runner: claude|openhands)
  batch <FD-NNN> [--runner=X]   Esegui tutti gli SDD di un FD
  watch <FD-NNN> [--runner=X]   Osserva e esegui nuovi SDD automaticamente
  fd-from-issue <number> [opts] Crea un FD draft da una GitHub issue

Runner:
  --runner=claude               Claude Code sub-agent (usa Max subscription)
  --runner=openhands            OpenHands container (usa API key)
  (default: da .forgia/config.toml)

USAGE
}

# --- runner resolution ---

resolve_runner() {
  local runner="${1:-}"

  # If explicitly passed, use it
  if [[ -n "$runner" ]]; then
    echo "$runner"
    return
  fi

  # Read from config
  local config_file="$VAULT_DIR/config.toml"
  if [[ -f "$config_file" ]]; then
    local default_runner
    default_runner=$(grep -A2 '\[runner\]' "$config_file" | grep 'default' | sed 's/.*= *"*//;s/"*$//' || echo "")
    if [[ -n "$default_runner" ]]; then
      echo "$default_runner"
      return
    fi
  fi

  # Fallback
  echo "claude"
}

get_runner_script() {
  local runner="$1"
  local script="$ROOT_DIR/modules/runners/${runner}.sh"

  if [[ ! -f "$script" ]]; then
    echo "Error: Unknown runner '$runner'. Available: claude, openhands" >&2
    exit 1
  fi

  echo "$script"
}

# Parse --runner=X from arguments
parse_runner_arg() {
  for arg in "$@"; do
    if [[ "$arg" =~ ^--runner=(.+)$ ]]; then
      echo "${BASH_REMATCH[1]}"
      return
    fi
  done
  echo ""
}

# Remove --runner=X from arguments
strip_runner_arg() {
  local args=()
  for arg in "$@"; do
    [[ "$arg" =~ ^--runner= ]] || args+=("$arg")
  done
  echo "${args[@]}"
}

# --- fd-from-issue helpers ---

next_fd_id() {
  local max_id=0
  for fd_file in "$VAULT_DIR"/fd/FD-*.md; do
    [[ -f "$fd_file" ]] || continue
    local num
    num=$(basename "$fd_file" | sed -E 's/^FD-0*([0-9]+).*/\1/')
    if (( num > max_id )); then
      max_id=$num
    fi
  done
  printf "FD-%03d" "$((max_id + 1))"
}

kebab_case() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g'
}

infer_repo() {
  local remote_url
  remote_url=$(git remote get-url origin 2>/dev/null || echo "")
  if [[ -z "$remote_url" ]]; then
    echo ""
    return
  fi
  echo "$remote_url" | sed -E 's|.*github\.com[:/]||;s|\.git$||'
}

map_labels_to_priority() {
  local labels="$1"
  if echo "$labels" | grep -qi "bug"; then
    echo "high"
  else
    echo "medium"
  fi
}

fetch_github_issue() {
  local repo="$1" number="$2" tmpdir="$3" fetch_comments="$4"

  # Extract scalar fields in a single API call using @tsv
  local scalars
  scalars=$(gh api "repos/$repo/issues/$number" \
    --jq '[.title, .state, (.assignee.login // empty), ([.labels[].name] | join(", ")), (.milestone.title // empty)] | @tsv' \
    2>/dev/null) || {
    echo "Error: Could not fetch issue #$number from $repo" >&2
    echo "  Check that the issue exists and you have access." >&2
    return 1
  }

  # Parse TSV: title \t state \t assignee \t labels \t milestone
  IFS=$'\t' read -r _title _state _assignee _labels _milestone <<< "$scalars"
  printf '%s' "$_title" > "$tmpdir/title"
  printf '%s' "$_state" > "$tmpdir/state"
  printf '%s' "$_assignee" > "$tmpdir/assignee"
  printf '%s' "$_labels" > "$tmpdir/labels"
  printf '%s' "$_milestone" > "$tmpdir/milestone"

  # Body is multiline — fetch separately
  gh api "repos/$repo/issues/$number" --jq '.body // empty' > "$tmpdir/body" 2>/dev/null || true

  if [[ "$fetch_comments" == "true" ]]; then
    gh api "repos/$repo/issues/$number/comments" --jq '.[].body' > "$tmpdir/comments" 2>/dev/null || true
  else
    : > "$tmpdir/comments"
  fi
}

# Source the context-discovery module
source "$ROOT_DIR/modules/context-discovery.sh"

# --- fd-from-issue ---

cmd_fd_from_issue() {
  local issue_number=""
  local repo_arg=""
  local extra_context=()
  local no_comments=false
  local dry_run=false

  # Parse args (supports both --repo=VALUE and --repo VALUE forms)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo=*) repo_arg="${1#--repo=}" ;;
      --repo) repo_arg="${2:?--repo requires a value}"; shift ;;
      --context=*) extra_context+=("${1#--context=}") ;;
      --context) extra_context+=("${2:?--context requires a value}"); shift ;;
      --no-comments) no_comments=true ;;
      --dry-run) dry_run=true ;;
      -*)
        echo "Error: Unknown option '$1'" >&2
        echo "Usage: forgia fd-from-issue <issue-number> [--repo OWNER/REPO] [--context PATH] [--no-comments] [--dry-run]" >&2
        exit 1
        ;;
      *)
        if [[ -z "$issue_number" ]]; then
          issue_number="$1"
        else
          echo "Error: Unexpected argument '$1'" >&2
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [[ -z "$issue_number" ]]; then
    echo "Usage: forgia fd-from-issue <issue-number> [options]" >&2
    echo "" >&2
    echo "Options:" >&2
    echo "  --repo=OWNER/REPO     GitHub repo (default: infer from git remote)" >&2
    echo "  --context=PATH        Additional context file/dir (repeatable)" >&2
    echo "  --no-comments         Skip fetching issue comments" >&2
    echo "  --dry-run             Print draft FD to stdout, don't write file" >&2
    exit 1
  fi

  # Check gh CLI
  if ! command -v gh >/dev/null 2>&1; then
    echo "Error: gh CLI not found. Install from https://cli.github.com/" >&2
    exit 1
  fi

  # Check gh auth
  if ! gh auth status >/dev/null 2>&1; then
    echo "Error: gh CLI not authenticated. Run: gh auth login" >&2
    exit 1
  fi

  # Resolve repo
  local repo="$repo_arg"
  if [[ -z "$repo" ]]; then
    repo=$(infer_repo)
    if [[ -z "$repo" ]]; then
      echo "Error: Could not infer repo from git remote. Use --repo=OWNER/REPO" >&2
      exit 1
    fi
  fi

  # Check vault
  if [[ ! -d "$VAULT_DIR/fd" ]]; then
    echo "Error: Vault not initialized. Run: forgia init" >&2
    exit 1
  fi

  # Create temp dir for issue data
  local tmpdir
  tmpdir=$(mktemp -d)
  # Chain cleanup onto any existing EXIT trap
  local _fdi_tmpdir="$tmpdir"
  local _fdi_prev_exit_trap
  _fdi_prev_exit_trap=$(trap -p EXIT)
  trap 'rm -rf "$_fdi_tmpdir"; eval "$_fdi_prev_exit_trap"' EXIT

  local fetch_comments="true"
  [[ "$no_comments" == "true" ]] && fetch_comments="false"

  echo "→ Fetching issue #$issue_number from $repo..."
  fetch_github_issue "$repo" "$issue_number" "$tmpdir" "$fetch_comments" || exit 1

  local title body labels assignee milestone
  title=$(cat "$tmpdir/title")
  body=$(cat "$tmpdir/body")
  labels=$(cat "$tmpdir/labels")
  assignee=$(cat "$tmpdir/assignee")
  milestone=$(cat "$tmpdir/milestone")

  # Fallback assignee to current user
  if [[ -z "$assignee" ]]; then
    assignee=$(gh api user --jq '.login' 2>/dev/null || echo "")
  fi

  # Context discovery
  echo "→ Discovering local context..."
  local context_section
  context_section=$(discover_context) || context_section=""

  if [[ -n "$context_section" ]]; then
    # Show discovered files
    echo "$context_section" | grep '^\- ' | while IFS= read -r line; do
      echo "  Found: $(echo "$line" | sed 's/^- `//;s/`.*//')"
    done
  fi

  # Add user-specified --context paths
  for ctx_path in "${extra_context[@]}"; do
    if [[ -f "$ctx_path" ]]; then
      context_section+=$'\n'"- \`$ctx_path\` — User-specified"
      echo "  Found: $ctx_path (--context)"
    elif [[ -d "$ctx_path" ]]; then
      for f in "$ctx_path"/*.md; do
        if [[ -f "$f" ]]; then
          context_section+=$'\n'"- \`$f\` — User-specified"
          echo "  Found: $f (--context)"
        fi
      done
    fi
  done

  # Determine next FD ID
  local fd_id
  fd_id=$(next_fd_id)
  local kebab
  kebab=$(kebab_case "$title")
  local fd_filename="${fd_id}-${kebab}.md"
  local fd_path="$VAULT_DIR/fd/$fd_filename"
  local today
  today=$(date +%Y-%m-%d)

  # Map labels to priority and tags array
  local priority
  priority=$(map_labels_to_priority "$labels")
  local tags_yaml="[]"
  if [[ -n "$labels" ]]; then
    # Convert "bug, enhancement, foo" to [bug, enhancement, foo]
    tags_yaml="[$(echo "$labels" | sed 's/, */, /g')]"
  fi

  # Build FD content from template
  local template="$VAULT_DIR/fd/_templates/fd-template.md"
  if [[ ! -f "$template" ]]; then
    template="$ROOT_DIR/modules/vault-template/fd/_templates/fd-template.md"
  fi

  local fd_content
  fd_content=$(cat "$template")

  # Substitute placeholders in frontmatter and heading
  fd_content=$(echo "$fd_content" | sed "s/{{ID}}/$fd_id/g")
  # Use awk for title to avoid sed issues with special chars
  fd_content=$(echo "$fd_content" | awk -v t="$title" '{gsub(/\{\{TITLE\}\}/, t); print}')
  fd_content=$(echo "$fd_content" | sed "s/{{DATE}}/$today/g")

  # Update frontmatter fields
  fd_content=$(echo "$fd_content" | sed "s/^priority: .*/priority: $priority/")
  fd_content=$(echo "$fd_content" | awk -v t="$tags_yaml" '/^tags:/{print "tags: " t; next} 1')
  fd_content=$(echo "$fd_content" | awk -v a="$assignee" '/^assignee:/{print "assignee: \"" a "\""; next} 1')

  # Add upstream_issue to frontmatter (before closing ---)
  fd_content=$(echo "$fd_content" | awk -v ui="$repo#$issue_number" '
    /^---$/ && NR > 1 && !done { print "upstream_issue: \"" ui "\""; done=1 }
    { print }
  ')

  # Replace Problem section content with issue body
  local problem_replacement
  problem_replacement=$(cat "$tmpdir/body")
  # Write to temp file for safe manipulation
  echo "$fd_content" > "$tmpdir/fd_draft.md"

  # Use awk to replace Problem section content
  awk -v bodyfile="$tmpdir/body" '
    /^## Problem/ { print; getline; while (/^<!--/) { print; getline }; printf "\n"; while ((getline line < bodyfile) > 0) print line; printf "\n"; skip=1; next }
    skip && /^## / { skip=0 }
    !skip { print }
  ' "$tmpdir/fd_draft.md" > "$tmpdir/fd_draft2.md"
  mv "$tmpdir/fd_draft2.md" "$tmpdir/fd_draft.md"

  # Replace Notes section with comments and context
  local notes_content=""
  local comments_text
  comments_text=$(cat "$tmpdir/comments")
  if [[ -n "$comments_text" ]]; then
    notes_content+="### Issue Comments

$comments_text
"
  fi
  if [[ -n "$context_section" ]]; then
    notes_content+="
$context_section
"
  fi

  if [[ -n "$notes_content" ]]; then
    # Write notes to temp file
    echo "$notes_content" > "$tmpdir/notes_content.md"
    awk -v notesfile="$tmpdir/notes_content.md" '
      /^## Notes/ { print; getline; while (/^<!--/) { print; getline }; printf "\n"; while ((getline line < notesfile) > 0) print line; printf "\n"; done_notes=1; next }
      done_notes && /^## / { done_notes=0 }
      !done_notes { print }
    ' "$tmpdir/fd_draft.md" > "$tmpdir/fd_draft2.md"
    mv "$tmpdir/fd_draft2.md" "$tmpdir/fd_draft.md"
  fi

  # Replace Constraints section with milestone info
  if [[ -n "$milestone" ]]; then
    local constraints_addition="- Milestone deadline: $milestone"
    awk -v c="$constraints_addition" '
      /^## Constraints/ { print; getline; while (/^<!--/) { print; getline }; printf "\n%s\n", c; skip_constraints=1; next }
      skip_constraints && /^## / { skip_constraints=0 }
      !skip_constraints { print }
    ' "$tmpdir/fd_draft.md" > "$tmpdir/fd_draft2.md"
    mv "$tmpdir/fd_draft2.md" "$tmpdir/fd_draft.md"
  fi

  if [[ "$dry_run" == "true" ]]; then
    cat "$tmpdir/fd_draft.md"
    echo ""
    echo "→ (dry-run — no file written)"
  else
    cp "$tmpdir/fd_draft.md" "$fd_path"
    echo "→ Creating $fd_id: $title"
    echo "  File: $fd_path"
    echo ""
    echo "✓ Draft FD created"
    echo "  Next: refine with /fd-from-issue or manually edit"
    echo "  Then: /fd-review $fd_id"
  fi
}

# --- init ---

cmd_init() {
  if [[ -d "$VAULT_DIR" ]]; then
    echo "Warning: $VAULT_DIR already exists"
    read -rp "Overwrite templates? (y/N) " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
  fi

  echo "→ Scaffolding $VAULT_DIR/"

  # Create directory structure
  mkdir -p "$VAULT_DIR"/{fd/_templates,sdd/_templates,ops/{_templates,active,done},dev-guide}

  # Copy templates
  local tmpl_dir="$ROOT_DIR/modules/vault-template"

  # Config
  if [[ ! -f "$VAULT_DIR/config.toml" ]]; then
    cp "$tmpl_dir/config.toml" "$VAULT_DIR/"
    echo "  Created: config.toml"
  fi

  # Constitution
  if [[ ! -f "$VAULT_DIR/constitution.md" ]]; then
    cp "$tmpl_dir/constitution.md" "$VAULT_DIR/"
    echo "  Created: constitution.md"
  fi

  # Dashboard
  if [[ ! -f "$VAULT_DIR/_dashboard.md" ]]; then
    cp "$tmpl_dir/_dashboard.md" "$VAULT_DIR/"
    echo "  Created: _dashboard.md"
  fi

  # FD template
  cp "$tmpl_dir/fd/_templates/fd-template.md" "$VAULT_DIR/fd/_templates/"
  echo "  Created: fd/_templates/fd-template.md"

  # SDD template
  cp "$tmpl_dir/sdd/_templates/sdd-template.md" "$VAULT_DIR/sdd/_templates/"
  echo "  Created: sdd/_templates/sdd-template.md"

  # OPS template
  cp "$tmpl_dir/ops/_templates/ops-task.md" "$VAULT_DIR/ops/_templates/"
  echo "  Created: ops/_templates/ops-task.md"

  # Guardrails (security deny/ignore)
  mkdir -p "$VAULT_DIR/guardrails"
  if [[ ! -f "$VAULT_DIR/guardrails/deny.toml" ]]; then
    cp "$tmpl_dir/guardrails/deny.toml" "$VAULT_DIR/guardrails/"
    echo "  Created: guardrails/deny.toml"
  fi
  if [[ ! -f "$VAULT_DIR/guardrails/ignore" ]]; then
    cp "$tmpl_dir/guardrails/ignore" "$VAULT_DIR/guardrails/"
    echo "  Created: guardrails/ignore"
  fi

  # Dev guide (always update)
  cp "$tmpl_dir/dev-guide/"*.md "$VAULT_DIR/dev-guide/" 2>/dev/null || true
  echo "  Created: dev-guide/"

  # Principles (always loaded — clean code, SOLID, design patterns)
  mkdir -p "$VAULT_DIR/dev-guide/principles"
  cp "$tmpl_dir/dev-guide/principles/"*.md "$VAULT_DIR/dev-guide/principles/"
  echo "  Created: dev-guide/principles/ (clean-code, solid, design-patterns)"

  # Language detection — auto-load relevant conventions
  mkdir -p "$VAULT_DIR/dev-guide/lang"
  local lang_dir="$tmpl_dir/dev-guide/lang"
  local detected=()

  if [[ -f "Cargo.toml" ]]; then
    cp "$lang_dir/rust.md" "$VAULT_DIR/dev-guide/lang/"
    detected+=("rust")
  fi

  if [[ -f "pyproject.toml" ]] || [[ -f "setup.py" ]] || [[ -f "requirements.txt" ]]; then
    cp "$lang_dir/python.md" "$VAULT_DIR/dev-guide/lang/"
    detected+=("python")
  fi

  if [[ -f "tsconfig.json" ]] || [[ -f "package.json" ]]; then
    cp "$lang_dir/typescript.md" "$VAULT_DIR/dev-guide/lang/"
    detected+=("typescript")
  fi

  if [[ -f "go.mod" ]]; then
    cp "$lang_dir/go.md" "$VAULT_DIR/dev-guide/lang/"
    detected+=("go")
  fi

  # Shell is always included (every project has scripts)
  cp "$lang_dir/shell.md" "$VAULT_DIR/dev-guide/lang/"
  detected+=("shell")

  if (( ${#detected[@]} > 0 )); then
    echo "  Detected languages: ${detected[*]}"
    echo "  Loaded conventions: dev-guide/lang/{${detected[*]}}.md"
  fi

  # Beads (bd) initialization
  if command -v bd >/dev/null 2>&1; then
    if [[ ! -d ".beads" ]]; then
      echo ""
      echo "→ Initializing Beads task tracker..."
      bd init 2>/dev/null || true
      echo "  Created: .beads/"
    else
      echo "  Beads: already initialized"
    fi
  else
    echo "  Beads: not installed (optional — run: mise run bd:install)"
  fi

  echo ""
  echo "✓ Vault scaffolded at $VAULT_DIR/"
  echo ""
  echo "Next steps:"
  echo "  1. Edit $VAULT_DIR/constitution.md with your project rules"
  echo "  2. Review $VAULT_DIR/dev-guide/lang/ conventions for your stack"
  echo "  3. Use /fd-new to create your first Feature Design"
  echo "  4. Use /fd-review to approve it"
  echo "  5. Use /fd-sdd to generate execution specs"
}

# --- status ---

cmd_status() {
  if [[ ! -d "$VAULT_DIR" ]]; then
    echo "No $VAULT_DIR found. Run: forgia init"
    exit 1
  fi

  echo "=== Forgia Dashboard ==="
  echo ""

  # FDs
  echo "--- Feature Designs ---"
  local fd_count=0
  for fd in "$VAULT_DIR"/fd/FD-*.md; do
    [[ -f "$fd" ]] || continue
    fd_count=$((fd_count + 1))
    local id title status
    id="$(grep '^id:' "$fd" | head -1 | sed 's/id: *//')"
    title="$(grep '^title:' "$fd" | head -1 | sed 's/title: *"*//;s/"*$//')"
    status="$(grep '^status:' "$fd" | head -1 | sed 's/status: *//')"
    printf "  %-10s %-12s %s\n" "$id" "[$status]" "$title"
  done
  if (( fd_count == 0 )); then
    echo "  (no FDs yet — use /fd-new to create one)"
  fi
  echo ""

  # SDDs
  echo "--- Execution Specs (SDD) ---"
  local sdd_count=0
  for fd_dir in "$VAULT_DIR"/sdd/FD-*/; do
    [[ -d "$fd_dir" ]] || continue
    local fd_id
    fd_id="$(basename "$fd_dir")"
    for sdd in "$fd_dir"SDD-*.md; do
      [[ -f "$sdd" ]] || continue
      sdd_count=$((sdd_count + 1))
      local sid stitle sstatus sagent
      sid="$(grep '^id:' "$sdd" | head -1 | sed 's/id: *//')"
      stitle="$(grep '^title:' "$sdd" | head -1 | sed 's/title: *"*//;s/"*$//')"
      sstatus="$(grep '^status:' "$sdd" | head -1 | sed 's/status: *//')"
      sagent="$(grep '^agent:' "$sdd" | head -1 | sed 's/agent: *//')"
      printf "  %-10s %-10s %-12s %-15s %s\n" "$fd_id" "$sid" "[$sstatus]" "($sagent)" "$stitle"
    done
  done
  if (( sdd_count == 0 )); then
    echo "  (no SDDs yet — use /fd-sdd after approving an FD)"
  fi
  echo ""

  # OPS
  echo "--- Active Tasks ---"
  local ops_count=0
  for ops in "$VAULT_DIR"/ops/active/OPS-*.md; do
    [[ -f "$ops" ]] || continue
    ops_count=$((ops_count + 1))
    local oid otitle
    oid="$(grep '^id:' "$ops" | head -1 | sed 's/id: *//')"
    otitle="$(grep '^title:' "$ops" | head -1 | sed 's/title: *"*//;s/"*$//')"
    printf "  %-10s %s\n" "$oid" "$otitle"
  done
  if (( ops_count == 0 )); then
    echo "  (no active tasks)"
  fi
  echo ""

  # Last executions
  if [[ -d "$VAULT_DIR/logs" ]]; then
    local json_reports=()
    for rpt in "$VAULT_DIR"/logs/exec-*.json; do
      [[ -f "$rpt" ]] && json_reports+=("$rpt")
    done
    if (( ${#json_reports[@]} > 0 )); then
      echo "--- Last Executions ---"
      for rpt in "${json_reports[@]}"; do
        local rsdd rduration rstatus
        rsdd=$(grep '"sdd"' "$rpt" | sed 's/.*: *"//;s/".*//' || echo "?")
        rduration=$(grep '"duration_seconds"' "$rpt" | sed 's/.*: *//;s/,.*//' || echo "?")
        rstatus=$(grep '"status"' "$rpt" | sed 's/.*: *"//;s/".*//' || echo "?")
        local rmins=$((rduration / 60)) rsecs=$((rduration % 60))
        printf "  %-10s %-10s %dm%ds\n" "$rsdd" "[$rstatus]" "$rmins" "$rsecs"
      done
      echo ""
    fi
  fi

  # Beads ready tasks
  if command -v bd >/dev/null 2>&1 && [[ -d ".beads" ]]; then
    echo "--- Beads (ready tasks) ---"
    bd ready 2>/dev/null || echo "  (no ready tasks)"
    echo ""
  fi

  echo ""
  echo "Summary: $fd_count FDs, $sdd_count SDDs, $ops_count active tasks"
}

# --- doctor ---

cmd_doctor() {
  echo "=== Forgia Doctor ==="
  echo ""

  local ok=0 warn=0 fail=0

  # Check vault
  if [[ -d "$VAULT_DIR" ]]; then
    printf "  %-25s OK\n" "vault (.forgia/)"
    ok=$((ok + 1))
  else
    printf "  %-25s MISSING (run: forgia init)\n" "vault (.forgia/)"
    fail=$((fail + 1))
  fi

  # Check constitution
  if [[ -f "$VAULT_DIR/constitution.md" ]]; then
    printf "  %-25s OK\n" "constitution"
    ok=$((ok + 1))
  else
    printf "  %-25s MISSING\n" "constitution"
    warn=$((warn + 1))
  fi

  # Check guardrails
  if [[ -f "$VAULT_DIR/guardrails/deny.toml" ]]; then
    local deny_count
    deny_count=$(grep -c 'patterns' "$VAULT_DIR/guardrails/deny.toml" 2>/dev/null || echo "0")
    printf "  %-25s OK (%s sections)\n" "guardrails (deny.toml)" "$deny_count"
    ok=$((ok + 1))
  else
    printf "  %-25s MISSING (run: forgia init)\n" "guardrails (deny.toml)"
    warn=$((warn + 1))
  fi

  if [[ -f "$VAULT_DIR/guardrails/ignore" ]]; then
    printf "  %-25s OK\n" "guardrails (ignore)"
    ok=$((ok + 1))
  else
    printf "  %-25s MISSING (run: forgia init)\n" "guardrails (ignore)"
    warn=$((warn + 1))
  fi

  # Check Docker
  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      printf "  %-25s OK\n" "docker"
      ok=$((ok + 1))
    else
      printf "  %-25s NOT RUNNING\n" "docker"
      warn=$((warn + 1))
    fi
  else
    printf "  %-25s NOT INSTALLED\n" "docker"
    fail=$((fail + 1))
  fi

  # Check OpenHands image
  if docker image inspect ghcr.io/openhands/openhands:latest >/dev/null 2>&1; then
    printf "  %-25s OK\n" "openhands image"
    ok=$((ok + 1))
  else
    printf "  %-25s NOT PULLED (run: mise run openhands:install)\n" "openhands image"
    warn=$((warn + 1))
  fi

  # Check OpenHands running
  if docker ps --format '{{.Image}}' 2>/dev/null | grep -q openhands; then
    printf "  %-25s RUNNING\n" "openhands container"
    ok=$((ok + 1))
  else
    printf "  %-25s STOPPED\n" "openhands container"
    warn=$((warn + 1))
  fi

  # Check mise
  if command -v mise >/dev/null 2>&1; then
    printf "  %-25s OK\n" "mise"
    ok=$((ok + 1))
  else
    printf "  %-25s NOT INSTALLED\n" "mise"
    fail=$((fail + 1))
  fi

  # Check Claude Code commands
  local cmd_count=0
  for cmd in "$HOME/.claude/commands"/fd-*.md "$HOME/.claude/commands"/sdd-*.md "$HOME/.claude/commands"/project-init.md; do
    [[ -f "$cmd" ]] && cmd_count=$((cmd_count + 1))
  done
  if (( cmd_count > 0 )); then
    printf "  %-25s OK (%d commands)\n" "claude-commands" "$cmd_count"
    ok=$((ok + 1))
  else
    printf "  %-25s NOT INSTALLED (run: mise run claude:install)\n" "claude-commands"
    warn=$((warn + 1))
  fi

  # Check Dolt (required by Beads)
  if command -v dolt >/dev/null 2>&1; then
    printf "  %-25s OK\n" "dolt"
    ok=$((ok + 1))
  else
    printf "  %-25s NOT INSTALLED (required by beads — run: mise run bd:install)\n" "dolt"
    warn=$((warn + 1))
  fi

  # Check Beads (bd)
  if command -v bd >/dev/null 2>&1; then
    printf "  %-25s OK\n" "beads (bd)"
    ok=$((ok + 1))
    if [[ -d ".beads" ]]; then
      printf "  %-25s OK\n" "beads repo (.beads/)"
      ok=$((ok + 1))
    else
      printf "  %-25s NOT INITIALIZED (run: bd init)\n" "beads repo (.beads/)"
      warn=$((warn + 1))
    fi
  else
    printf "  %-25s NOT INSTALLED (optional — run: mise run bd:install)\n" "beads (bd)"
    warn=$((warn + 1))
  fi

  # Check fswatch (for forgia watch)
  if command -v fswatch >/dev/null 2>&1; then
    printf "  %-25s OK\n" "fswatch"
    ok=$((ok + 1))
  else
    printf "  %-25s NOT INSTALLED (optional — brew install fswatch)\n" "fswatch"
    warn=$((warn + 1))
  fi

  # Check yq (for YAML SDD validation)
  if command -v yq >/dev/null 2>&1; then
    printf "  %-25s OK\n" "yq"
    ok=$((ok + 1))
  else
    printf "  %-25s NOT INSTALLED (optional — brew install yq)\n" "yq"
    warn=$((warn + 1))
  fi

  # Check LLM key
  if [[ -n "${ANTHROPIC_API_KEY:-}" ]] || [[ -n "${OPENAI_API_KEY:-}" ]]; then
    printf "  %-25s OK\n" "llm api key"
    ok=$((ok + 1))
  else
    printf "  %-25s MISSING (set ANTHROPIC_API_KEY or OPENAI_API_KEY)\n" "llm api key"
    warn=$((warn + 1))
  fi

  echo ""
  echo "Summary: $ok OK, $warn warnings, $fail failures"
}

# --- validate ---

cmd_validate() {
  local target="${1:?Usage: forgia validate <sdd-file|FD-NNN>}"
  local validate_script="$ROOT_DIR/modules/runners/validate-sdd.sh"

  if [[ -f "$target" ]]; then
    # Single file
    "$validate_script" "$target"
  elif [[ -d "$VAULT_DIR/sdd/$target" ]]; then
    # FD directory — validate all SDDs
    local total=0 valid=0 invalid=0
    for sdd in "$VAULT_DIR/sdd/$target"/SDD-*.{md,yaml,yml}; do
      [[ -f "$sdd" ]] || continue
      total=$((total + 1))
      echo ""
      if "$validate_script" "$sdd"; then
        valid=$((valid + 1))
      else
        invalid=$((invalid + 1))
      fi
    done

    if (( total == 0 )); then
      echo "No SDDs found for $target"
      exit 1
    fi

    echo ""
    echo "=== Validation Summary: $target ==="
    echo "  Total: $total | Valid: $valid | Invalid: $invalid"
    (( invalid == 0 )) || exit 1
  else
    echo "Error: '$target' is not a file or FD identifier" >&2
    exit 1
  fi
}

# --- exec ---

cmd_exec() {
  local sdd_file="${1:?Usage: forgia exec <sdd-file> [--runner=claude|openhands]}"
  local runner
  runner=$(resolve_runner "$(parse_runner_arg "$@")")
  local script
  script=$(get_runner_script "$runner")

  echo "→ Executing $sdd_file with runner: $runner"
  echo ""

  # Pre-exec validation
  local validate_script="$ROOT_DIR/modules/runners/validate-sdd.sh"
  if ! "$validate_script" "$sdd_file"; then
    echo ""
    echo "Error: SDD validation failed — fix errors before execution" >&2
    exit 1
  fi
  echo ""

  # Update SDD status to in-progress
  if [[ -f "$sdd_file" ]] && grep -q '^status:' "$sdd_file"; then
    sed -i.bak 's/^status: .*/status: in-progress/' "$sdd_file"
    rm -f "${sdd_file}.bak"
  fi

  "$script" "$sdd_file"

  # Update SDD status to done
  if [[ -f "$sdd_file" ]]; then
    sed -i.bak 's/^status: .*/status: done/' "$sdd_file"
    rm -f "${sdd_file}.bak"
  fi

  # Close corresponding bd task if it exists
  if command -v bd >/dev/null 2>&1 && [[ -d ".beads" ]]; then
    local sdd_id
    sdd_id=$(grep '^id:' "$sdd_file" 2>/dev/null | head -1 | sed 's/id: *//')
    if [[ -n "$sdd_id" ]]; then
      # Find bd task tagged with this SDD id and close it
      local bd_task_id
      bd_task_id=$(bd search "$sdd_id" --format=json 2>/dev/null | grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//') || true
      if [[ -n "$bd_task_id" ]]; then
        bd update "$bd_task_id" --status=done 2>/dev/null || true
        echo "  → Beads task $bd_task_id closed"
      fi
    fi
  fi
}

# --- batch ---

cmd_batch() {
  local fd_id="${1:?Usage: forgia batch <FD-NNN> [--runner=claude|openhands]}"
  local runner
  runner=$(resolve_runner "$(parse_runner_arg "$@")")
  local sdd_dir="$VAULT_DIR/sdd/$fd_id"

  if [[ ! -d "$sdd_dir" ]]; then
    echo "Error: No SDDs found for $fd_id at $sdd_dir" >&2
    exit 1
  fi

  local sdd_files=()
  for sdd in "$sdd_dir"/SDD-*.md; do
    [[ -f "$sdd" ]] || continue
    local sstatus
    sstatus=$(grep '^status:' "$sdd" | head -1 | sed 's/status: *//')
    if [[ "$sstatus" != "done" ]]; then
      sdd_files+=("$sdd")
    fi
  done

  if (( ${#sdd_files[@]} == 0 )); then
    echo "No pending SDDs for $fd_id"
    exit 0
  fi

  echo "=== Forgia Batch Execution ==="
  echo "  FD:     $fd_id"
  echo "  Runner: $runner"
  echo "  SDDs:   ${#sdd_files[@]} pending"
  echo ""

  local completed=0 failed=0
  for sdd_file in "${sdd_files[@]}"; do
    local sid
    sid=$(grep '^id:' "$sdd_file" | head -1 | sed 's/id: *//')
    echo "--- Executing $sid ---"

    if cmd_exec "$sdd_file" --runner="$runner"; then
      completed=$((completed + 1))
    else
      failed=$((failed + 1))
      echo "  Warning: $sid failed" >&2
    fi
    echo ""
  done

  echo "=== Batch Complete ==="
  echo "  Completed: $completed"
  echo "  Failed:    $failed"
}

# --- watch ---

cmd_watch() {
  local fd_id="${1:?Usage: forgia watch <FD-NNN> [--runner=claude|openhands]}"
  local runner
  runner=$(resolve_runner "$(parse_runner_arg "$@")")
  local sdd_dir="$VAULT_DIR/sdd/$fd_id"

  if ! command -v fswatch >/dev/null 2>&1; then
    echo "Error: fswatch not found. Install with: brew install fswatch" >&2
    exit 1
  fi

  mkdir -p "$sdd_dir"

  # Read debounce from config
  local debounce=5
  if [[ -f "$VAULT_DIR/config.toml" ]]; then
    debounce=$(grep -A3 '\[watcher\]' "$VAULT_DIR/config.toml" | grep -v '^#' | grep 'debounce' | head -1 | sed 's/.*= *//' | tr -d ' ' || echo "5")
  fi

  echo "=== Forgia Watcher ==="
  echo "  Watching:  $sdd_dir"
  echo "  Runner:    $runner"
  echo "  Debounce:  ${debounce}s"
  echo "  Logs:      $VAULT_DIR/logs/"
  echo ""
  echo "  Waiting for new SDDs... (Ctrl+C to stop)"
  echo ""

  # Track already-processed files
  local processed_file
  processed_file=$(mktemp)

  # Pre-populate with files that are already done or in-progress (skip them)
  # Files with status: planned are NOT skipped — they need execution
  for existing in "$sdd_dir"/SDD-*.md; do
    [[ -f "$existing" ]] || continue
    local existing_status
    existing_status=$(grep '^status:' "$existing" 2>/dev/null | head -1 | sed 's/status: *//' || echo "")
    if [[ "$existing_status" == "done" ]] || [[ "$existing_status" == "in-progress" ]]; then
      echo "$existing" >> "$processed_file"
    fi
  done

  # Execute any existing planned SDDs first
  local pending_count=0
  for existing in "$sdd_dir"/SDD-*.md; do
    [[ -f "$existing" ]] || continue
    if grep -qF "$existing" "$processed_file" 2>/dev/null; then
      continue
    fi
    pending_count=$((pending_count + 1))
  done

  if (( pending_count > 0 )); then
    echo "  Found $pending_count pending SDD(s) — executing now..."
    echo ""
  fi

  local watch_start=$SECONDS
  local exec_count=0

  # Execute pending SDDs immediately
  for existing in "$sdd_dir"/SDD-*.md; do
    [[ -f "$existing" ]] || continue
    if grep -qF "$existing" "$processed_file" 2>/dev/null; then
      continue
    fi

    local sdd_name
    sdd_name=$(basename "$existing")
    local elapsed=$(( SECONDS - watch_start ))
    local mins=$(( elapsed / 60 )) secs=$(( elapsed % 60 ))

    echo "$existing" >> "$processed_file"
    exec_count=$((exec_count + 1))

    printf "┌── [%02d:%02d] Pending SDD: %s\n" "$mins" "$secs" "$sdd_name"
    echo "│   Launching exec (runner: $runner)..."
    echo "│"

    if cmd_exec "$existing" --runner="$runner"; then
      local end_elapsed=$(( SECONDS - watch_start ))
      local end_mins=$(( end_elapsed / 60 )) end_secs=$(( end_elapsed % 60 ))
      printf "└── [%02d:%02d] %s DONE\n" "$end_mins" "$end_secs" "$sdd_name"
    else
      printf "└── [%02d:%02d] %s FAILED\n" "$end_mins" "$end_secs" "$sdd_name"
    fi
    echo ""
  done

  if (( exec_count > 0 )); then
    echo "  $exec_count pending SDD(s) executed. Now watching for new ones..."
    echo ""
  fi

  # Watch for new SDD files
  fswatch -0 --event Created --event Updated "$sdd_dir" | while IFS= read -r -d '' file; do
    # Only process SDD markdown files
    [[ "$file" =~ SDD-.*\.md$ ]] || continue

    # Skip if already processed
    if grep -qF "$file" "$processed_file" 2>/dev/null; then
      continue
    fi

    # Debounce — wait for file to be fully written
    sleep "$debounce"

    local sdd_name
    sdd_name=$(basename "$file")
    local elapsed=$(( SECONDS - watch_start ))
    local mins=$(( elapsed / 60 )) secs=$(( elapsed % 60 ))

    echo "$file" >> "$processed_file"
    exec_count=$((exec_count + 1))

    printf "┌── [%02d:%02d] New SDD detected: %s\n" "$mins" "$secs" "$sdd_name"
    echo "│   Launching exec (runner: $runner)..."
    echo "│   Log: $VAULT_DIR/logs/exec-*-$(date +%Y-%m-%d)*.log"
    echo "│"

    # Execute — foreground so we see the live output
    if cmd_exec "$file" --runner="$runner"; then
      local end_elapsed=$(( SECONDS - watch_start ))
      local end_mins=$(( end_elapsed / 60 )) end_secs=$(( end_elapsed % 60 ))
      printf "└── [%02d:%02d] %s DONE\n" "$end_mins" "$end_secs" "$sdd_name"
    else
      printf "└── [%02d:%02d] %s FAILED\n" "$end_mins" "$end_secs" "$sdd_name"
    fi
    echo ""
    echo "  Waiting for more SDDs... ($exec_count executed so far)"
    echo ""
  done

  rm -f "$processed_file"

  rm -f "$processed_file"
}

# --- main ---

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  local cmd="$1"
  shift || true

  case "$cmd" in
    init)     cmd_init ;;
    status)   cmd_status ;;
    doctor)   cmd_doctor ;;
    validate) cmd_validate "$@" ;;
    exec)     cmd_exec "$@" ;;
    batch)    cmd_batch "$@" ;;
    watch)    cmd_watch "$@" ;;
    fd-from-issue) cmd_fd_from_issue "$@" ;;
    *)       usage; exit 1 ;;
  esac
}

main "$@"
